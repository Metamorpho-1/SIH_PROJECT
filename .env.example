# ==========================================
# AURA-Fire Operational Intelligence System
# Environment Configuration
# ==========================================

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-this-in-production-aura-fire-secret-2026

# NASA FIRMS API
# Obtain map key from: https://firms.modaps.eosdis.nasa.gov/api/map_key/
NASA_FIRMS_MAP_KEY=your_nasa_firms_map_key_here
FIRMS_COUNTRY_CODE=IND
FIRMS_SENSOR=VIIRS_SNPP_NRT

# PostgreSQL 16 + PostGIS 3.4
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=aura_user
POSTGRES_PASSWORD=aura_password
POSTGRES_DB=aura_fire_db
DATABASE_URL=postgresql+asyncpg://aura_user:aura_password@localhost:5432/aura_fire_db

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Microsoft Planetary Computer (Sentinel-2 STAC API)
PC_STAC_API_URL=https://planetarycomputer.microsoft.com/api/stac/v1
PC_API_KEY=

# Open-Meteo API (Weather & 10m Wind Vectors for Gaussian Plume)
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast

# Frontend Configuration
VITE_MAPBOX_TOKEN=your_mapbox_gl_access_token
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_BASE_URL=ws://localhost:8000/ws
